 import java.util.*;

public class DFS_List {
    public static void main(String[] args) {

        int n = 5; // number of vertices

        List<Integer>[] adj = new ArrayList[n];
        for (int i = 0; i < n; i++)
            adj[i] = new ArrayList<>();

        // Hardcoded edges
        adj[0].add(1);
        adj[1].add(0);

        adj[0].add(2);
        adj[2].add(0);

        adj[1].add(3);
        adj[3].add(1);

        adj[1].add(4);
        adj[4].add(1);

        boolean[] visited = new boolean[n];

        int start = 0; // starting vertex

        System.out.print("DFS Traversal: ");

        Stack<Integer> stack = new Stack<>();
        stack.push(start);

        while (!stack.isEmpty()) {
            int v = stack.pop();

            if (!visited[v]) {
                System.out.print(v + " ");
                visited[v] = true;

                // reverse order for correct DFS
                for (int i = adj[v].size() - 1; i >= 0; i--) {
                    int node = adj[v].get(i);
                    if (!visited[node]) {
                        stack.push(node);
                    }
                }
            }
        }
    }
}
